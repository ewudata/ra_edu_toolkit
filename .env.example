# Backend API Configuration
BACKEND_BASE_URL=http://localhost:8000
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Frontend Configuration
FRONTEND_BASE_URL=http://localhost:5173
FRONTEND_PORT=5173

# CORS (comma-separated origins allowed by backend)
CORS_ORIGINS=http://localhost:5173

# Supabase Configuration
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
OAUTH_STATE_SECRET=
SUPABASE_USER_DATASETS_BUCKET=ra-user-datasets

# LLM Hint Generator Configuration
LLM_ENABLED=False
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# AI stays unavailable until the operator reviews the deployed service's data handling.
LLM_PRIVACY_REVIEWED=false
LLM_SERVICE_NAME=
# Describe verified retention, training use, and who operates the service.
LLM_DATA_POLICY=
LLM_PRIVACY_URL=

# Public evaluation limits (shared across workers on the same host).
RA_GUEST_REQUESTS_PER_MINUTE=60
RA_GUEST_GLOBAL_REQUESTS_PER_MINUTE=600
RA_EVALUATION_TIMEOUT_SECONDS=5
RA_MAX_INTERMEDIATE_ROWS=100000
# Linux RA subprocess address-space limit. Other platforms enforce timeout/row limits.
RA_WORKER_MEMORY_MB=2048
# Optional path to a private SQLite file shared by all workers on one host.
RA_RATE_LIMIT_DB=

# Development Settings
DEBUG=True
RELOAD=True
